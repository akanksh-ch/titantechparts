{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["name", "price", "rating", "reviews", "imageUrl", "category", "stock", "createdAt"],
    "additionalProperties": false,
    "properties": {
      "_id": {
        "bsonType": "objectId",
        "description": "Inventory item identifier"
      },
      "name": {
        "bsonType": "string",
        "minLength": 1,
        "maxLength": 128,
        "description": "Product name"
      },
      "price": {
        "bsonType": "double",
        "minimum": 0,
        "description": "Product price"
      },
      "rating": {
        "bsonType": "double",
        "minimum": 0,
        "maximum": 5,
        "description": "Product rating (0-5 scale)"
      },
      "reviews": {
        "bsonType": "array",
        "description": "Customer reviews",
        "items": {
          "bsonType": "object",
          "properties": {
            "reviewerId": {
              "bsonType": "objectId",
              "description": "Reviewer user ID"
            },
            "reviewer": {
              "bsonType": "string",
              "description": "Reviewer name"
            },
            "text": {
              "bsonType": "string",
              "description": "Review text"
            },
            "rating": {
              "bsonType": "int",
              "minimum": 1,
              "maximum": 5
            },
            "date": {
              "bsonType": "date",
              "description": "Review date"
            }
          }
        }
      },
      "imageUrl": {
        "bsonType": "string",
        "description": "Product image URL"
      },
      "category": {
        "bsonType": "string",
        "enum": ["CPU", "CPU Cooler", "Motherboard", "Memory", "Storage", "GPU", "Power Supply", "Case"],
        "description": "Product category"
      },
      "stock": {
        "bsonType": "int",
        "minimum": 0,
        "description": "Units in stock"
      },
      "createdAt": {
        "bsonType": "date",
        "description": "Creation timestamp"
      }
    }
  }
}